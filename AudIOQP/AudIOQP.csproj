<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>AudIOQP</RootNamespace>
    <AssemblyName>AudIOQP</AssemblyName>
    <Version>0.0.1</Version>
    <Product>AudIOQP</Product>
    <Description>Windows tray app that switches the default audio output device.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Local builds bump PATCH. Pass -p:IncrementPatchVersion=false for a release so the committed version ships unchanged. -->
    <IncrementPatchVersion Condition="'$(IncrementPatchVersion)' == ''">true</IncrementPatchVersion>
  </PropertyGroup>

  <Target Name="IncrementPatchVersion" BeforeTargets="GetAssemblyVersion" Condition="'$(DesignTimeBuild)' != 'true' AND '$(IncrementPatchVersion)' == 'true'">
    <Exec Command="python &quot;$(UserProfile)\bin\csproj-version.py&quot; &quot;$(MSBuildProjectFullPath)&quot;" />
    <XmlPeek XmlInputPath="$(MSBuildProjectFullPath)" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="Version" />
    </XmlPeek>
  </Target>
</Project>
